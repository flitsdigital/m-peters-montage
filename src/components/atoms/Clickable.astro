---
/**
 * Webflow's g_clickable-patroon: een onzichtbare, vullende link (of submit-
 * button) over een visueel component heen. De parent moet position:relative
 * en een z-context hebben — zo blijven card-markup en klikgedrag gescheiden.
 *
 * Het origineel rendert altijd link + button en verbergt er één met CSS
 * (`a[href="#"] { display:none }`); hier renderen we conditioneel.
 */
interface Props {
  /** Toegankelijk label (het origineel liet de sr-only span leeg — gefixt). */
  label: string;
  href?: string;
  target?: string;
  type?: "button" | "submit";
  current?: boolean;
}

const { label, href, target, type = "button", current } = Astro.props;
---

<div class="g_clickable_wrap">
  {
    href ? (
      <a
        href={href}
        target={target}
        aria-current={current ? "page" : undefined}
        class="g_clickable_link"
      >
        <span class="u-sr-only">{label}</span>
      </a>
    ) : (
      <button type={type} class="g_clickable_btn">
        <span class="u-sr-only">{label}</span>
      </button>
    )
  }
</div>

<style>
  .g_clickable_wrap {
    z-index: 3;
    border-radius: inherit;
    width: 100%;
    height: 100%;
    position: absolute;
    inset: 0%;
  }

  .g_clickable_link,
  .g_clickable_btn {
    border-radius: inherit;
    width: 100%;
    height: 100%;
    display: block;
    position: absolute;
    inset: 0%;
  }
</style>
