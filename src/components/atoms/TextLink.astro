---
/**
 * Tekstlink met pijl-icoon (btn_link) — "Meer lezen" in blogkaarten.
 * Rendert géén anchor: de omliggende kaart is de link (Clickable-patroon).
 */
import Icon, { type IconName } from "./Icon.astro";

interface Props {
  label: string;
  icon?: IconName;
}

const { label, icon = "arrow-right" } = Astro.props;
---

<div class="btn_link">
  <div class="btn_icon-wrap"><Icon name={icon} class="g_svg" /></div>
  <div>{label}</div>
</div>

<style>
  .btn_link {
    grid-column-gap: 0.5rem;
    grid-row-gap: 0.5rem;
    justify-content: flex-start;
    align-items: center;
    display: flex;
  }

  .btn_icon-wrap {
    z-index: 3;
    width: 1.25rem;
  }

  .btn_icon-wrap :global(.g_svg) {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible !important;
  }
</style>
