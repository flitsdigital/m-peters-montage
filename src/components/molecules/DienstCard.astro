---
/**
 * Dienstenkaart (diensten_item): beeld met zoom-hover, zwevende
 * "MEER LEZEN"-chip met pijl-wissel, titel en tekst. De hele kaart is de link.
 */
import Visual from "./Visual.astro";
import ReadMoreLink from "./ReadMoreLink.astro";
import type { ImageMetadata } from "astro";

interface Props {
  href: string;
  title: string;
  text: string;
  image: ImageMetadata | string;
  alt: string;
}

const { href, title, text, image, alt } = Astro.props;
---

<a {href} class="diensten_item">
  <div class="diensten_img-wrap">
    <Visual src={image} {alt} sizes="(max-width: 991px) 100vw, 33vw" />
  </div>
  <div class="diensten_content-wrap">
    <ReadMoreLink />
    <h3>{title}</h3>
    <p>{text}</p>
  </div>
</a>

<style>
  .diensten_item {
    background-color: var(--theme--background-secondary);
    display: block;
    position: relative;
    overflow: hidden;
  }

  .diensten_img-wrap {
    aspect-ratio: 3 / 2;
    position: relative;
    overflow: hidden;
  }

  .diensten_content-wrap {
    padding: var(--space--7) var(--space--6) var(--space--6);
    position: relative;
  }

  /* Hover: beeld zoomt, pijlen wisselen diagonaal (uit de page-code embed). */
  .diensten_item :global(img) {
    transition: transform 0.3s;
  }

  .diensten_item:hover :global(img) {
    transform: scale(1.1);
  }

  .diensten_item:hover :global(.diensten_link-icon1) {
    transform: translate(100%, -100%);
  }

  .diensten_item:hover :global(.diensten_link-icon2) {
    transform: translate(0, 0);
  }

  @media screen and (max-width: 479px) {
    .diensten_content-wrap {
      padding-right: var(--space--4);
      padding-left: var(--space--4);
    }
  }
</style>
