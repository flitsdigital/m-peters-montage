---
/**
 * Projectgalerij (section_project-images): gecentreerde intro + 3-koloms grid
 * met vierkante foto's die in een lightbox openen.
 *
 * Vervangt Webflow's w-lightbox door een native <dialog> — geen library nodig.
 */
import SectionShell from "./SectionShell.astro";
import Image from "../atoms/Image.astro";
import RichText from "../atoms/RichText.astro";
import type { ImageMetadata } from "astro";

interface GalleryImage {
  src: ImageMetadata | string;
  alt: string;
}

interface Props {
  images: GalleryImage[];
}

const { images } = Astro.props;
---

<SectionShell name="section_project-images" theme="inherit">
  <div class="u-mb-8">
    <div class="u-grid-desktop">
      <div class="u-column-centered project-images_body">
        <RichText><slot /></RichText>
      </div>
    </div>
  </div>

  <div class="u-grid-column-3" data-lightbox-group>
    {
      images.map((img, i) => (
        <div class="project-images_img">
          <button
            type="button"
            class="project-images_lightbox"
            data-lightbox-open={i}
            aria-label={`Foto ${i + 1} van ${images.length} vergroten`}
          >
            <Image
              src={img.src}
              alt={img.alt}
              class="project-images_lightbox-img"
              sizes="(max-width: 767px) 100vw, 33vw"
            />
          </button>
        </div>
      ))
    }
  </div>

  <dialog class="lightbox" data-lightbox>
    <button type="button" class="lightbox_close" data-lightbox-close aria-label="Sluiten"
      >×</button
    >
    <div class="lightbox_stage">
      {
        images.map((img, i) => (
          <img src={typeof img.src === "string" ? img.src : img.src.src} alt={img.alt} data-lightbox-slide={i} hidden />
        ))
      }
    </div>
  </dialog>
</SectionShell>

<script>
  document.querySelectorAll<HTMLElement>("[data-lightbox-group]").forEach((group) => {
    const section = group.closest("section")!;
    const dialog = section.querySelector<HTMLDialogElement>("[data-lightbox]");
    if (!dialog) return;

    const slides = dialog.querySelectorAll<HTMLElement>("[data-lightbox-slide]");

    const show = (index: number) => {
      slides.forEach((slide, i) => (slide.hidden = i !== index));
      dialog.showModal();
    };

    group.querySelectorAll<HTMLElement>("[data-lightbox-open]").forEach((button) =>
      button.addEventListener("click", () => show(Number(button.dataset.lightboxOpen))),
    );

    dialog
      .querySelector("[data-lightbox-close]")!
      .addEventListener("click", () => dialog.close());

    // Klik buiten de foto sluit ook.
    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  });
</script>

<style>
  /* .u-column-centered centreert ook de tekst; bij opsommingen komt het
     bolletje daardoor los van zijn regel te staan. Kolom blijft gecentreerd
     in het grid, de tekst erin lijnt links uit. */
  .project-images_body {
    text-align: left;
    align-items: stretch;
  }

  .project-images_img {
    aspect-ratio: 1;
    position: relative;
  }

  .project-images_lightbox {
    width: 100%;
    height: 100%;
    display: block;
    overflow: hidden;
  }

  .project-images_lightbox :global(.project-images_lightbox-img) {
    height: 100%;
    transition: transform 0.3s;
  }

  .project-images_lightbox:hover :global(.project-images_lightbox-img) {
    transform: scale(1.05);
  }

  .lightbox {
    max-width: 100vw;
    max-height: 100vh;
    width: 100%;
    height: 100%;
    border: 0;
    padding: var(--site--margin);
    background: color-mix(in srgb, var(--swatch--dark-100) 90%, transparent);
  }

  .lightbox::backdrop {
    background: color-mix(in srgb, var(--swatch--dark-100) 90%, transparent);
  }

  .lightbox_stage {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .lightbox_stage img {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
  }

  .lightbox_close {
    position: absolute;
    top: var(--site--margin);
    right: var(--site--margin);
    width: 3rem;
    height: 3rem;
    font-size: 2rem;
    line-height: 1;
    color: var(--swatch--light-100);
    background: var(--swatch--dark-80);
  }
</style>
