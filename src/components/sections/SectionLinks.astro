---
/**
 * Linkkolom (section_links) — de handige-links-pagina.
 */
import SectionShell from "./SectionShell.astro";

interface Link {
  label: string;
  href: string;
}

interface Props {
  links: Link[];
}

const { links } = Astro.props;
---

<SectionShell name="section_links" theme="inherit">
  <div class="u-grid-desktop">
    <div class="u-column-6">
      <div class="links_wrap">
        {links.map((l) => <a href={l.href} target="_blank" rel="noopener">{l.label}</a>)}
      </div>
    </div>
  </div>
</SectionShell>

<style>
  .links_wrap {
    flex-flow: column;
    display: flex;
  }
</style>
